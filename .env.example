# AWS Credentials
# Replace these with your actual AWS credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# AWS Region (default: us-east-1)
AWS_DEFAULT_REGION=us-east-1

# S3 Bucket for MLflow artifacts
# This bucket must already exist in your AWS account
MLFLOW_S3_BUCKET=your-mlflow-bucket-name

# Optional: Uncomment if using a specific S3 endpoint
# AWS_S3_ENDPOINT_URL=https://s3.us-west-2.amazonaws.com

# LLM Provider API Keys for GenAI Features
# Uncomment and add your keys to enable GenAI evaluation and tracking
# OPENAI_API_KEY=sk-your-openai-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# OpenAI-compatible base URL (for local LLMs via Ollama, LM Studio, etc.)
# Default in docker-compose-local.yml points to host Ollama: http://host.docker.internal:11434/v1
# Ollama:    OPENAI_API_BASE=http://host.docker.internal:11434/v1
# LM Studio: OPENAI_API_BASE=http://host.docker.internal:1234/v1
# OpenAI:    OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_API_BASE=http://host.docker.internal:11434/v1

# Optional: GenAI Evaluation Configuration
# MLFLOW_GENAI_EVAL_MAX_WORKERS=10
# MLFLOW_GENAI_EVAL_ASYNC_TIMEOUT=300
