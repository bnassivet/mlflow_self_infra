# MLflow Server
MLFLOW_VERSION=mlflow[genai]>=3.10.0
MLFLOW_HOST=0.0.0.0
# Note: MLFLOW_PORT is used for BOTH the host and container port (they must match, so the
# assistant can self-call the in-server AI Gateway via the browser-supplied Host header).
MLFLOW_PORT=5010

# Exposed Ports (host-side mappings — change to avoid conflicts)
POSTGRES_PORT=5432        # PostgreSQL host port (full-stack and AWS configs)
RUSTFS_API_PORT=9000      # RustFS S3 API host port
RUSTFS_CONSOLE_PORT=9001  # RustFS web console host port

# PostgreSQL (full-stack and AWS configs)
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow123
POSTGRES_DB=mlflow

# RustFS S3 artifact storage (full-stack config only)
RUSTFS_ROOT_USER=rustfs
RUSTFS_ROOT_PASSWORD=rustfs123
RUSTFS_BUCKET=mlflow
# Internal URL used by the MLflow container to reach RustFS
MLFLOW_S3_ENDPOINT_URL=http://rustfs:9000

# AWS Credentials
# Replace these with your actual AWS credentials (AWS config only)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# AWS Region (default: us-east-1)
AWS_DEFAULT_REGION=us-east-1

# S3 Bucket for MLflow artifacts
# This bucket must already exist in your AWS account (AWS config only)
MLFLOW_S3_BUCKET=your-mlflow-bucket-name

# Optional: Uncomment if using a custom S3 endpoint
# AWS_S3_ENDPOINT_URL=https://s3.us-west-2.amazonaws.com

# LLM Provider API Keys for GenAI Features
# Uncomment and add your keys to enable GenAI evaluation and tracking
# OPENAI_API_KEY=sk-your-openai-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# OpenAI-compatible base URL (for local LLMs via Ollama, LM Studio, etc.)
# Default in docker-compose-local-light.yml points to host Ollama: http://host.docker.internal:11434/v1
# Ollama:    OPENAI_API_BASE=http://host.docker.internal:11434/v1
# LM Studio: OPENAI_API_BASE=http://host.docker.internal:1234/v1
# OpenAI:    OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_API_BASE=http://host.docker.internal:11434/v1

# Optional: GenAI Evaluation Configuration
# MLFLOW_GENAI_EVAL_MAX_WORKERS=10
# MLFLOW_GENAI_EVAL_ASYNC_TIMEOUT=300

# MLflow Assistant (Beta)
# The assistant API is localhost-only by design (it can run the MLflow CLI and edit code).
# Behind Docker the browser is never seen as localhost, so every assistant call 403s with
# "You do not have permission to access this resource". Setting this to true lifts that,
# but ONLY for providers declaring allows_remote_access — i.e. "MLflow AI Gateway".
# Ollama / plain OpenAI-compatible providers remain blocked even with this enabled;
# configure an Ollama-backed endpoint under LLM Connections and select the Gateway provider.
MLFLOW_ENABLE_REMOTE_ASSISTANT=true

# Encryption key for AI Gateway secrets (LLM Connections) stored in Postgres.
# MLflow uses a well-known default passphrase when this is unset — fine for a
# throwaway localhost server, not for anything reachable on your network.
# Generate one with: openssl rand -base64 32
# MLFLOW_CRYPTO_KEK_PASSPHRASE=

# Port MLflow itself listens on inside the container (loopback only). An in-container
# socat relay forwards MLFLOW_PORT -> this, so the server sees a real 127.0.0.1 peer and
# the assistant's privileged routes (endpoint dropdown, settings Save) work. Rarely needs
# changing, but it must differ from MLFLOW_PORT.
MLFLOW_INTERNAL_PORT=5000
